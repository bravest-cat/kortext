# ==============================================================================
# Kortext Configuration Environment Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# ── Inference Endpoints & Models (Universal Hardware & Provider Support) ───────
# Kortext is 100% hardware-agnostic and provider-agnostic.
# Supported Backends:
#   - Apple Silicon (Metal): oMLX, MLX-LM, Ollama, LM Studio
#   - NVIDIA GPUs (CUDA): vLLM, Text Embeddings Inference (TEI), Ollama, LocalAI
#   - AMD GPUs (ROCm): vLLM, Ollama
#   - CPU / Cloud: llama.cpp, FastEmbed, OpenAI, Azure OpenAI, Groq, Together
#
# Dense Embedder (Zero-Config FastEmbed local ONNX by default)
# Kortext defaults out-of-the-box to local ONNX (BAAI/bge-small-en-v1.5, 384-dim).
# No external server or GPU daemon required.
#
# Custom Endpoint Fallback (Optional):
# To use a custom OpenAI-compatible embedding server (oMLX, vLLM, TEI, Ollama, OpenAI):
# EMBED_BASE_URL=http://localhost:8000/v1
# EMBED_MODEL_NAME=mlx-community--Qwen3-Embedding-8B-4bit-DWQ
# EMBED_DIMENSION=4096
# EMBED_API_KEY=not-needed

# Direct LLM Completion / Fallback Endpoint (Optional: local reasoning or summarization)
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=mlx-community--Qwen3.5-9B-oQ5e-MTP-VL
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_NAME=mlx-community--Qwen3-8B-Instruct-4bit
LLM_API_KEY=not-needed

# ── FalkorDB Native Substrate (Graph Database for AST Symbols & Episodic Memory)
# Primary transport: Unix Domain Socket (UDS) for <1ms latency IPC.
# Fallback transport: Loopback TCP on 127.0.0.1:6379.
FALKORDB_SOCKET=~/.kortext/run/falkordb.sock
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_DATABASE=kortext
FALKORDB_SYMBOLS_GRAPH=kortext_symbols

# ── Qdrant Vector Store (Native Local Engine) ──────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kortext_codebase

# ── MCP daemon (one per machine; every agy window proxies to it) ─────────────────
# KORTEXT_DAEMON_PORT=8767
# KORTEXT_SERVER_MODE=inprocess   # serve each window in its own process instead (single window only)

# ── Retrieval Parameters ───────────────────────────────────────────────────────
RETRIEVE_TOP_K=30
RETRIEVE_RESULTS=5

# ── Kortext Storage & Runtime Paths ──────────────────────────────────────────
KORTEXT_HOME=~/.kortext
JOURNAL_DIR=
WORKSPACE_ROOTS=

# ── Ingestion & Chunking Settings ─────────────────────────────────────────────
INGEST_EXCLUDE_PATTERNS=.git,node_modules,__pycache__,.venv,dist,build,*.gguf,*.pyc,*.log,*.lock,.DS_Store,coverage/,target/,*.min.js,vendor,vendors,third_party,extern,deps
INGEST_CHUNK_SIZE=2048
INGEST_CHUNK_OVERLAP=128
EMBED_BATCH_SIZE=8
EMBED_CONCURRENCY=1

# ── Kortext Web Dashboard ────────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8004

# ── File Watcher & Synchronization Settings ───────────────────────────────────
KORTEXT_WATCH_DEBOUNCE=2.0
