{
  "display_name": "Kortext Cognitive Dream Consolidation",
  "description": "Memory consolidation, stale-fact pruning and invariant induction daemon",
  "builtin": "schedule",
  "args": [
    "0 * * * *",
    "sh",
    "run.sh"
  ],
  "restart_policy": "on-failure",
  "env": {
    "KORTEXT_HOME": "${HOME}/.kortext"
  }
}
